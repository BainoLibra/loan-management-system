generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum UserRole {
  admin
  loan_officer
  cashier
  branch_manager
  client
}

enum UserStatus {
  active
  inactive
}

enum ClientStatus {
  active
  inactive
}

enum LoanStatus {
  applied
  revision_requested
  approved
  disbursed
  closed
  rejected
}

model Group {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  description String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  clients   Client[]

  @@map("groups")
}

model User {
  id                 Int        @id @default(autoincrement())
  name               String
  email              String     @unique
  password           String
  role               UserRole
  status             UserStatus @default(active)
  emailVerified      Boolean    @default(true)
  emailVerifiedAt    DateTime?
  emailVerificationToken String?
  emailVerificationExpires DateTime?
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  createdLoans       Loan[]     @relation("LoanCreatedBy")
  approvedLoans      Loan[]     @relation("LoanApprovedBy")
  repayments         Repayment[]
  auditLogs          AuditLog[]

  @@index([email])
  @@map("users")
}

model Client {
  id         Int           @id @default(autoincrement())
  firstName     String
  lastName      String
  phone         String?
  email         String?
  identifier    String?
  address       String?
  guarantorName String?
  guarantorPhone String?
  guarantorId   String?
  groupId       Int?
  status        ClientStatus  @default(active)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  group      Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  loans      Loan[]

  @@index([groupId])
  @@map("clients")
}

model Loan {
  id           Int         @id @default(autoincrement())
  clientId     Int
  amount       Decimal     @db.Decimal(15, 2)
  interestRate Decimal     @db.Decimal(5, 2)
  termMonths   Int
  guarantorName String?
  notes        String?
  documents    String?     // file path or URL
  status       LoanStatus  @default(applied)
  appliedAt    DateTime?
  approvedBy   Int?
  approvedAt   DateTime?
  approvedAmount Decimal?   @db.Decimal(15, 2)
  approvalReason String?
  revisionReason String?
  disbursedAt  DateTime?
  balance      Decimal     @db.Decimal(15, 2)
  createdBy    Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdByUser User       @relation("LoanCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  approvedByUser User?     @relation("LoanApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  repayments   Repayment[]
  schedules    Schedule[]

  @@index([clientId])
  @@index([approvedBy])
  @@index([createdBy])
  @@map("loans")
}

model Repayment {
  id         Int      @id @default(autoincrement())
  loanId     Int
  amount     Decimal  @db.Decimal(15, 2)
  paidBy     Int
  date       DateTime
  createdAt  DateTime @default(now())
  loan       Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  paidByUser User     @relation(fields: [paidBy], references: [id], onDelete: Restrict)

  @@index([loanId])
  @@index([paidBy])
  @@map("repayments")
}

model Schedule {
  id         Int      @id @default(autoincrement())
  loanId     Int
  month      Int
  dueDate    DateTime
  payment    Decimal  @db.Decimal(15, 2)
  principal  Decimal  @db.Decimal(15, 2)
  interest   Decimal  @db.Decimal(15, 2)
  balance    Decimal  @db.Decimal(15, 2)
  status     String   @default("pending") // pending, paid, overdue
  penalty    Decimal  @db.Decimal(15, 2) @default(0)
  createdAt  DateTime @default(now())
  loan       Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@map("schedules")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String?
  entity     String?
  entityId   Int?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("audit_logs")
}
