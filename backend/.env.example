# =========================================
# REQUIRED: Supabase PostgreSQL Database
# =========================================
# Get these from your Supabase project settings:
# 1. Go to https://app.supabase.com/project/_/settings/database
# 2. Find the "Connection pooling" section (port 6543) for DATABASE_URL
# 3. Find the "Direct connection" section (port 5432) for DIRECT_URL
# 4. Password contains special characters - must be URL encoded in connection strings

# Connection pooling URL (for app runtime)
# Format: postgresql://postgres.[project]:[password]@db.[project].supabase.co:6543/postgres
DATABASE_URL=

# Direct connection URL (for migrations and data import/export)
# Format: postgresql://postgres.[project]:[password]@db.[project].supabase.co:5432/postgres
DIRECT_URL=

# =========================================
# Application Configuration
# =========================================
PORT=4000

# JWT Secret for token signing (REQUIRED for production)
# Generate with: openssl rand -base64 32
# Example: SX7ximFpHYYQPjSpW2W57xgXApUICxXqTbCWGwmn6Uc=
JWT_SECRET=SX7ximFpHYYQPjSpW2W57xgXApUICxXqTbCWGwmn6Uc=

# Frontend URL for CORS configuration
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Optional: Disable automatic admin seeding
SEED_DEFAULT_ADMIN=true

# =========================================
# Email Configuration
# =========================================
# Required for password reset emails. For Gmail, use an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Libra Loan Management <your-gmail-address@gmail.com>"

