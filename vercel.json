{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/[...all].js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/[...all].js"
    },
    {
      "src": "/health",
      "dest": "/backend/api/[...all].js"
    },
    {
      "src": "/test-db",
      "dest": "/backend/api/[...all].js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
